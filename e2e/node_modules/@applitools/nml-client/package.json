{
  "name": "@applitools/nml-client",
  "version": "1.12.16",
  "description": "Client to integrate the SDKs to the Native Mobile Library (NML)",
  "homepage": "https://applitools.com",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Applitools Team",
    "email": "team@applitools.com"
  },
  "files": [
    "dist",
    "types"
  ],
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "run --top-level eslint '**/*.ts'",
    "build": "run --top-level tsc --project ./tsconfig.build.json",
    "test": "run --top-level mocha './test/**/*.spec.ts' --parallel --jobs ${MOCHA_JOBS:-15}",
    "test:sauce": "MOCHA_OMIT_TAGS=android-emulator run test",
    "setup:android-emulator": "npx --yes appium@2 driver install uiautomator2@2.34.2 && node ./test/android-emulator.js",
    "test:android-emulator": "MOCHA_ONLY_TAGS=android-emulator MOCHA_GROUP=android-emulator run --top-level mocha './test/e2e/*.spec.ts' --exit"
  },
  "dependencies": {
    "@applitools/logger": "2.3.4",
    "@applitools/req": "1.11.9",
    "@applitools/utils": "1.15.4"
  },
  "devDependencies": {
    "@applitools/core-base": "1.44.1",
    "@applitools/spec-driver-webdriver": "^1.6.17",
    "@applitools/test-server": "^1.4.11",
    "@applitools/test-utils": "^1.5.17",
    "@types/node": "^12.20.55",
    "nock": "^13.3.2",
    "webdriver": "^7.31.1"
  },
  "peerDependencies": {
    "@applitools/core-base": "1.44.1"
  },
  "engines": {
    "node": ">=12.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "lavamoat": {
    "allowScripts": {
      "@applitools/core-base>@applitools/image>sharp": false
    }
  }
}