{
  "name": "@applitools/core",
  "version": "4.77.1",
  "homepage": "https://applitools.com",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Applitools Team",
    "email": "team@applitools.com"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./offline": {
      "types": "./types/offline.d.ts",
      "default": "./dist/offline.js"
    },
    "./types": {
      "types": "./types/types.d.ts",
      "default": "./dist/types.js"
    },
    "./dist/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "eyes-check-network": "./dist/troubleshoot/check-network.js"
  },
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "browser": {
    "@applitools/ec-client": false
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "lint": "run --top-level eslint '**/*.ts'",
    "build": "yarn build:dist",
    "build:dist": "run --top-level tsc --project ./tsconfig.build.json",
    "test": "run --top-level mocha './test/**/*.spec.ts' --exclude 'test/e2e/mocha-sync/**' --parallel --jobs ${MOCHA_JOBS:-15} --exit --require ./test/mocha-global-setup.js",
    "test:local": "MOCHA_OMIT_TAGS=sauce,browserstack,ios-simulator,android-emulator,pdf-external run test",
    "test:sauce": "MOCHA_ONLY_TAGS=sauce,browserstack run test",
    "test:bin": "MOCHA_GROUP=bin run --top-level mocha './test/bin/**/*.spec.ts' --parallel --jobs ${MOCHA_JOBS:-15} --require ./test/mocha-global-setup.js",
    "test:e2e": "MOCHA_OMIT_TAGS=http2,ios-simulator,android-emulator,pdf-external MOCHA_GROUP=e2e run --top-level mocha './test/e2e/**/*.spec.ts' --exclude 'test/e2e/mocha-sync/**' --parallel --jobs ${MOCHA_JOBS:-15} --exit --require ./test/mocha-global-setup.js",
    "test:e2e:http2": "APPLITOOLS_HTTP_VERSION=2 MOCHA_OMIT_TAGS=http1,sauce,browserstack,ios-simulator,android-emulator,pdf-external MOCHA_GROUP=e2e run --top-level mocha './test/e2e/**/*.spec.ts' --exclude 'test/e2e/mocha-sync/**' --parallel --jobs ${MOCHA_JOBS:-15} --exit --require ./test/mocha-global-setup.js",
    "test:it": "MOCHA_GROUP=it run --top-level mocha './test/it/**/*.spec.ts' --require ./test/mocha-global-setup.js",
    "test:e2e:sync": "MOCHA_GROUP=e2e SYNC=true run --top-level mocha './test/e2e/mocha-sync/**/*.spec.ts' --exit --require ./test/mocha-global-setup.js",
    "test:unit": "MOCHA_GROUP=unit run --top-level mocha './test/unit/**/*.spec.ts' --require ./test/mocha-global-setup.js",
    "setup": "run --top-level browsers:setup && run --top-level xvfb:setup && run playwright:setup",
    "playwright:setup": "node -e \"var v=parseInt(process.version.slice(1));if(v>=18){require('child_process').execSync('yarn playwright install --with-deps firefox',{stdio:'inherit'})}else{console.log('Skipping playwright install (Node '+process.version+')')}\"",
    "setup:standalone": "sh -c 'yarn chromedriver --port=4444 --verbose &'",
    "setup:ios-simulator": "npx --yes appium@3 driver install xcuitest && cd ../../../test/apps/ios/IOSTestApp && xcodebuild -project IOSTestApp.xcodeproj -target IOSTestApp -configuration Release -sdk iphonesimulator CODE_SIGNING_ALLOWED=NO SYMROOT=build build",
    "test:ios-simulator": "MOCHA_ONLY_TAGS=ios-simulator MOCHA_GROUP=ios-simulator run --top-level mocha ./test/e2e/classic/webview.spec.ts --exit --require ./test/mocha-global-setup.js",
    "setup:android-emulator": "npx --yes appium@2 driver install uiautomator2@2.34.2 && node ./test/android-emulator.js",
    "test:android-emulator": "MOCHA_ONLY_TAGS=android-emulator MOCHA_GROUP=android-emulator run --top-level mocha './test/e2e/**/*.spec.ts' --exclude 'test/e2e/mocha-sync/**' --exit --require ./test/mocha-global-setup.js",
    "test:pdf-external": "MOCHA_ONLY_TAGS=pdf-external MOCHA_GROUP=e2e run --top-level mocha './test/e2e/pdf/**/*.spec.ts' --exit --require ./test/mocha-global-setup.js"
  },
  "dependencies": {
    "@applitools/core-base": "1.44.1",
    "@applitools/dom-capture": "11.8.13",
    "@applitools/dom-snapshot": "4.18.11",
    "@applitools/driver": "1.26.17",
    "@applitools/ec-client": "1.12.60",
    "@applitools/image": "1.3.6",
    "@applitools/logger": "2.3.4",
    "@applitools/nml-client": "1.12.16",
    "@applitools/req": "1.11.9",
    "@applitools/screenshoter": "3.12.39",
    "@applitools/snippets": "2.9.12",
    "@applitools/socket": "1.3.20",
    "@applitools/task-manager": "1.1.0",
    "@applitools/ufg-client": "1.27.1",
    "@applitools/utils": "1.15.4",
    "abort-controller": "3.0.0",
    "chalk": "4.1.2",
    "fast-xml-parser": "5.11.1",
    "node-fetch": "2.6.7",
    "semver": "7.6.2",
    "shell-quote": "^1.8.4",
    "throat": "6.0.2"
  },
  "devDependencies": {
    "@applitools/bongo": "^5.10.0",
    "@applitools/spec-driver-playwright": "^1.9.17",
    "@applitools/spec-driver-puppeteer": "^1.8.17",
    "@applitools/spec-driver-selenium": "^1.8.17",
    "@applitools/spec-driver-webdriver": "^1.6.17",
    "@applitools/test-server": "^1.4.11",
    "@applitools/test-utils": "^1.5.17",
    "@applitools/tunnel-client": "^1.12.12",
    "@swc-node/register": "^1.6.8",
    "@types/mocha": "^10.0.7",
    "@types/node": "^12.20.55",
    "@types/selenium-webdriver": "^4.1.2",
    "@types/semver": "^7.5.8",
    "@types/shell-quote": "^1",
    "chai": "^4.2.0",
    "chromedriver": "^131.0.5",
    "crypto": "^1.0.1",
    "express": "^4.10.6",
    "mocha": "^11.7.5",
    "nock": "^13.3.2",
    "playwright": "1.55.1",
    "png-async": "^0.9.4",
    "pngjs": "^3.0.0",
    "puppeteer": "^24.11.1",
    "selenium-webdriver": "^4.15.0",
    "webdriver": "^5.23.0"
  },
  "engines": {
    "node": ">=12.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "lavamoat": {
    "allowScripts": {
      "chromedriver": true,
      "puppeteer": true,
      "ws>bufferutil": false,
      "ws>utf-8-validate": false,
      "@swc-node/register>@swc/core": false,
      "selenium-webdriver>ws>bufferutil": false,
      "selenium-webdriver>ws>utf-8-validate": false,
      "@applitools/image>sharp": false
    }
  }
}