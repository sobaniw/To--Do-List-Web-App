{
  "name": "@applitools/ufg-client",
  "version": "1.27.1",
  "homepage": "https://applitools.com",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Applitools Team",
    "email": "team@applitools.com"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "browser": {
    "jsdom": false
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "lint": "run --top-level eslint '**/*.ts'",
    "build": "run --top-level tsc --project ./tsconfig.build.json",
    "test": "run --top-level mocha './test/**/*.spec.ts' --parallel --jobs ${MOCHA_JOBS:-15}",
    "test:it": "MOCHA_GROUP=it run --top-level mocha './test/it/**/*.spec.ts'",
    "test:unit": "MOCHA_GROUP=unit run --top-level mocha './test/unit/**/*.spec.ts'"
  },
  "dependencies": {
    "@applitools/image": "1.3.6",
    "@applitools/logger": "2.3.4",
    "@applitools/req": "1.11.9",
    "@applitools/utils": "1.15.4",
    "@xmldom/xmldom": "^0.8.12",
    "abort-controller": "3.0.0",
    "css-tree": "^3.1.0",
    "throat": "6.0.2"
  },
  "devDependencies": {
    "@applitools/test-server": "^1.4.11",
    "@applitools/test-utils": "^1.5.17",
    "@types/css-tree": "^2.3.7",
    "@types/node": "^12.20.55",
    "nock": "^13.3.2",
    "node-fetch": "2.6.7"
  },
  "engines": {
    "node": ">=12.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "lavamoat": {
    "allowScripts": {
      "@applitools/image>sharp": false
    }
  }
}