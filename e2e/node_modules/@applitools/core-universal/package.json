{
  "name": "@applitools/core-universal",
  "version": "1.3.1",
  "homepage": "https://applitools.com",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Applitools Team",
    "email": "team@applitools.com"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "bin": "./dist/cli/cli.js",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "lint": "run --top-level eslint '**/*.ts'",
    "build": "yarn build:dist",
    "build:dist": "run --top-level tsc --project ./tsconfig.build.json",
    "build:bin": "bash ../../../scripts/build-binary-local.sh core-universal",
    "setup": "run --top-level browsers:setup && run --top-level xvfb:setup",
    "test:e2e": "run --top-level mocha './test/e2e/**/*.spec.ts' --parallel --jobs ${MOCHA_JOBS:-15} --exit --require ./test/mocha-global-setup.js",
    "test:bin": "MOCHA_GROUP=bin run --top-level mocha './test/bin/**/*.spec.ts' --parallel --jobs ${MOCHA_JOBS:-15} --require ./test/mocha-global-setup.js"
  },
  "dependencies": {
    "@applitools/core": "4.77.1",
    "@applitools/driver": "1.26.17",
    "@applitools/logger": "2.3.4",
    "@applitools/socket": "1.3.20",
    "@applitools/spec-driver-webdriver": "1.6.17",
    "@applitools/utils": "1.15.4",
    "@types/ws": "8.5.5",
    "chalk": "4.1.2",
    "webdriver": "7.31.1",
    "ws": "8.21.1",
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "@applitools/bongo": "^5.10.0",
    "@applitools/test-server": "^1.4.11",
    "@applitools/test-utils": "^1.5.17",
    "@types/mocha": "^10.0.7",
    "@types/node": "^12.20.55",
    "@types/yargs": "^17.0.22",
    "webdriverio": "^8.14.3"
  },
  "engines": {
    "node": ">=12.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "lavamoat": {
    "allowScripts": {
      "ws>bufferutil": false,
      "ws>utf-8-validate": false,
      "webdriverio>@wdio/utils>edgedriver": false,
      "webdriverio>@wdio/utils>geckodriver": false,
      "webdriverio>devtools>@wdio/utils>geckodriver": false,
      "@applitools/core>@applitools/image>sharp": false
    }
  }
}